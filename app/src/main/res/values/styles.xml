<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.PocketArcade" parent="Theme.AppCompat.NoActionBar">
        <item name="colorPrimary">@color/azul_neon</item>
        <item name="colorAccent">@color/amarelo</item>
        <item name="android:windowBackground">@drawable/bg_gradiente</item>
        <item name="android:statusBarColor">@color/bg_topo</item>
        <item name="android:navigationBarColor">@color/bg_base</item>
    </style>

    <style name="Pocket.Titulo" parent="">
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">@dimen/texto_titulo</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Pocket.Corpo" parent="">
        <item name="android:textColor">@color/texto_sec</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
    </style>

    <style name="Pocket.Botao" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_botao_primario</item>
        <item name="android:textColor">@color/escuro</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">17sp</item>
        <item name="android:minHeight">58dp</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="Pocket.BotaoSecundario" parent="Pocket.Botao">
        <item name="android:background">@drawable/bg_botao_secundario</item>
        <item name="android:textColor">@color/azul_neon</item>
        <item name="android:paddingBottom">0dp</item>
    </style>

    <style name="Pocket.Campo" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_campo</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/cinza</item>
        <item name="android:textSize">@dimen/texto_corpo</item>
        <item name="android:padding">16dp</item>
    </style>
</resources>