<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll_codigo_secreto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/margem_tela">

        <TextView
            android:id="@+id/txt_titulo"
            style="@style/Pocket.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cofre_tela_titulo" />

        <TextView
            android:id="@+id/txt_boas_vindas"
            style="@style/Pocket.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno" />

        <TextView
            android:id="@+id/txt_instrucao"
            style="@style/Pocket.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:text="@string/cofre_instrucao" />

            <TextView
                style="@style/Pocket.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/legenda_verde"
                android:textColor="@color/verde" />

            <TextView
                style="@style/Pocket.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/legenda_amarelo"
                android:textColor="@color/amarelo" />

            <TextView
                style="@style/Pocket.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/legenda_cinza"
                android:textColor="@color/cinza" />

        <TextView
            android:id="@+id/txt_tentativas"
            style="@style/Pocket.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_tela"
            android:textColor="@color/azul_neon"
            android:textSize="18sp" />

        <EditText
            android:id="@+id/edit_palpite"
            style="@style/Pocket.Campo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:hint="@string/hint_palpite"
            android:imeOptions="actionDone"
            android:importantForAutofill="no"
            android:inputType="number" />

        <TextView
            android:id="@+id/txt_erro"
            style="@style/Pocket.Corpo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco_pequeno"
            android:textColor="@color/vermelho"
            android:visibility="gone" />

        <Button
            android:id="@+id/btn_tentar"
            style="@style/Pocket.Botao"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/espaco"
            android:text="@string/btn_tentar" />

        <LinearLayout
            android:id="@+id/painel_resultado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_tela"
            android:background="@drawable/bg_resultado"
            android:orientation="vertical"
            android:padding="@dimen/margem_tela"
            android:visibility="gone">

            <TextView
                android:id="@+id/txt_resultado_titulo"
                style="@style/Pocket.Titulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textSize="22sp" />

            <TextView
                android:id="@+id/txt_resultado_detalhes"
                style="@style/Pocket.Corpo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco_pequeno"
                android:gravity="center" />

            <Button
                android:id="@+id/btn_nova_partida"
                style="@style/Pocket.Botao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/espaco"
                android:text="@string/btn_nova_partida" />
        </LinearLayout>

        <TextView
            android:id="@+id/txt_historico_titulo"
            style="@style/Pocket.Titulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margem_tela"
            android:text="@string/historico_titulo"
            android:textSize="20sp" />

        <LinearLayout
            android:id="@+id/container_historico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_voltar"
                style="@style/Pocket.BotaoSecundario"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/btn_voltar_menu" />

            <Button
                android:id="@+id/btn_encerrar"
                style="@style/Pocket.Botao"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/espaco_pequeno"
                android:layout_weight="1"
                android:text="@string/btn_encerrar_sessao" />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
