<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="#4A4478" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <solid android:color="#6E679E" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item android:state_pressed="true">
        <layer-list>
            <item android:top="4dp">
                <shape android:shape="rectangle">
                    <solid android:color="@color/laranja_escuro" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="2dp" android:top="4dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/laranja_neon"
                        android:startColor="@color/amarelo" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item>
                <shape android:shape="rectangle">
                    <solid android:color="@color/laranja_escuro" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
            <item android:bottom="6dp">
                <shape android:shape="rectangle">
                    <gradient
                        android:angle="270"
                        android:endColor="@color/laranja_neon"
                        android:startColor="@color/amarelo" />
                    <corners android:radius="18dp" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>