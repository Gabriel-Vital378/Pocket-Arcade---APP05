<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@drawable/ic_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.PocketArcade">

        <!-- Tela 1: unica Activity de entrada (LAUNCHER) -->
        <activity
            android:name=".ApresentacaoActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Tela 2 -->
        <activity
            android:name=".CentralActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- Telas 3 a 6: desafios -->
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".ArenaActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".CodigoSecretoActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
        <activity
            android:name=".RandomizadorActivity"
            android:exported="false"
            android:screenOrientation="portrait" />
    </application>

</manifest>
